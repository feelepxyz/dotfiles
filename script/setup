#!/usr/bin/env bash
# Link shared dotfiles and restore skills; optionally install native packages.
set -euo pipefail

PACKAGES=false
SKILLS=true
for arg in "$@"; do
  case "$arg" in
    --packages) PACKAGES=true ;;
    --skip-skills) SKILLS=false ;;
    -h|--help)
      echo "usage: script/setup [--packages] [--skip-skills]"
      echo "Link dotfiles and restore skills on macOS or Omarchy."
      echo "--packages installs the Brewfile or Omarchy package lists first."
      echo "--skip-skills links dotfiles without Node.js or network access."
      exit 0 ;;
    *) echo "Unknown option: $arg" >&2; exit 2 ;;
  esac
done

# Resolve symlinks without GNU-only readlink -f (macOS ships BSD readlink).
SCRIPT="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT" ]; do
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT")" && pwd)"
  SCRIPT="$(readlink "$SCRIPT")"
  [[ "$SCRIPT" = /* ]] || SCRIPT="$SCRIPT_DIR/$SCRIPT"
done
DOTFILES="$(cd "$(dirname "$SCRIPT")/.." && pwd -P)"
case "$(uname -s)" in
  Darwin) PLATFORM=macos ;;
  Linux) PLATFORM=linux ;;
  *) echo "Supported platforms: macOS and Omarchy (Linux)" >&2; exit 1 ;;
esac

if $PACKAGES; then
  if [ "$PLATFORM" = macos ]; then
    brew bundle check --file "$DOTFILES/home/.Brewfile" ||
      brew bundle --file "$DOTFILES/home/.Brewfile"
  else
    for manifest in omarchy omarchy-aur; do
      packages=()
      while read -r package _ || [ -n "$package" ]; do
        case "$package" in ''|\#*) continue ;; esac
        packages+=("$package")
      done < "$DOTFILES/install/$manifest.packages"
      [ "${#packages[@]}" -gt 0 ] || continue
      if [ "$manifest" = omarchy ]; then
        omarchy pkg add "${packages[@]}"
      else
        omarchy pkg aur add "${packages[@]}"
      fi
    done
  fi
fi

if $SKILLS && ! command -v npx >/dev/null 2>&1; then
  echo "Skills need Node.js/npm. Install them, or use --skip-skills to link dotfiles only." >&2
  exit 1
fi

# Restore public skill sources before installing the Git config's SSH rewrite.
if $SKILLS; then
  "$DOTFILES/install/skills.sh"
fi

BACKUP=""
link_file() {
  local source="$1" relative="$2" target="$HOME/$2"
  if [ -L "$target" ] && [ "$(readlink "$target")" = "$source" ]; then
    return
  fi
  if [ -e "$target" ] || [ -L "$target" ]; then
    if [ -z "$BACKUP" ]; then
      BACKUP="$(mktemp -d "$HOME/.dotfiles-backup.XXXXXX")"
      echo "Backing up existing dotfiles to $BACKUP"
    fi
    mkdir -p "$BACKUP/$(dirname "$relative")"
    mv "$target" "$BACKUP/$relative"
  fi
  mkdir -p "$(dirname "$target")"
  ln -s "$source" "$target"
  echo "Linked $relative"
}

# Link tracked files at any depth; never install generated state or credentials.
# Keep shared directories (.config, .ssh, .claude, etc.) as real directories.
while IFS= read -r -d '' file; do
  relative="${file#home/}"
  if [ "$PLATFORM" = linux ]; then
    # Homebrew/asdf are macOS-only; Omarchy uses its existing mise installation.
    case "$relative" in .Brewfile|.tool-versions) continue ;; esac
  fi
  # These are self-contained configs, linked as directories below.
  case "$relative" in .config/nvim/*|.pi/agent/extensions/*) continue ;; esac
  link_file "$DOTFILES/$file" "$relative"
  # Omarchy already includes ~/.local/bin in PATH (also outside Zsh).
  if [ "$PLATFORM" = linux ] && [[ "$relative" = .bin/* ]]; then
    link_file "$DOTFILES/$file" ".local/bin/${relative#.bin/}"
  fi
done < <(git -C "$DOTFILES" ls-files -z -- home/)

link_file "$DOTFILES/home/.config/nvim" .config/nvim
link_file "$DOTFILES/home/.pi/agent/extensions" .pi/agent/extensions
link_file "$DOTFILES/install/git-$PLATFORM.conf" .config/git/dotfiles-platform.conf

echo "Dotfiles installed ($PLATFORM)."
