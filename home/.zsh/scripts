# find shorthand
f() {
  find . -name "$1"
}

# Start an HTTP server from a directory, optionally specifying the port
static-server() {
  local port="${1:-8000}"
  if [[ "$OSTYPE" == darwin* ]]; then
    open "http://localhost:${port}/"
  else
    xdg-open "http://localhost:${port}/"
  fi
  python3 -m http.server "$port"
}

chrome() {
  local browser=chromium
  if [[ "$OSTYPE" == darwin* ]]; then
    browser="/Applications/Google Chrome Canary.app/Contents/MacOS/Google Chrome Canary"
  fi
  "$browser" "$@"
}

# Find processes running on port
open-port() {
  if [[ $# -ne 1 || "$1" != <1-65535> ]]; then
    print -u2 'usage: open-port PORT'
    return 1
  fi
  lsof -nP -i ":$1"
}

function gh-clone() {
  local repo_url=${1:-}
  local repo_host
  local repo_path
  local repo_pattern='^(https?://|git@)([[:alnum:].-]+)[/:]([[:alnum:]_.-]+(/[[:alnum:]_.-]+)+)$'

  if [[ $# -eq 1 && $repo_url =~ $repo_pattern ]]; then
    repo_host=$match[2]
    repo_path=$match[3]
    repo_path="${repo_path%.git}"
  else
    print -u2 'usage: gh-clone https://HOST/OWNER/REPO or git@HOST:OWNER/REPO'
    return 1
  fi
  if [[ "/$repo_path/" == *'/../'* || "/$repo_path/" == *'/./'* || "$repo_host" == . || "$repo_host" == .. ]]; then
    print -u2 'Repository URL must not contain . or .. path components'
    return 1
  fi

  local dest_folder="$HOME/src/$repo_host/$repo_path"
  # Check if the destination folder exists
  if [ -d "$dest_folder" ]; then
    echo "$dest_folder: already exists"
    builtin cd -- "$dest_folder"
    return $?
  fi

  # Clone the repo and cd into it
  git clone -- "$repo_url" "$dest_folder" && builtin cd -- "$dest_folder"
}

docker-debug() {
  if [ -z "$1" ]; then
    echo "usage: docker-debug CONTAINER-ID"
    return 1
  fi

  echo "Starting debug sidecar for container $1"

  mkdir -p -- "/tmp/debug-$1" || return
  echo "Mounting /scratch to /tmp/debug-$1"

  docker run --rm -ti \
    --name="debug-${1:0:6}" \
    --workdir="/scratch" \
    --volume="/tmp/debug-$1:/scratch" \
    --pid="container:$1" \
    --network="container:$1" \
    --cap-add sys_admin \
    --cap-add sys_ptrace \
    hmarr/debug-tools
}

docker-debug-latest() {
  local container
  container="$(docker ps --latest --quiet)" || return
  docker-debug "$container"
}

function mkcd() {
  if [[ $# -ne 1 || -z "$1" ]]; then
    print -u2 'usage: mkcd DIRECTORY'
    return 1
  fi
  mkdir -p -- "$1" && builtin cd -- "$1"
}

youtube-dl() {
  yt-dlp -x --audio-format m4a --audio-quality 0 \
  --add-metadata --embed-thumbnail --split-chapters \
  -o "%(title)s.%(ext)s" -- "$@"
}

# Create/attach a tmux session for a project directory (defaults to $PWD).
# Session name is the directory basename, with the standard agent/review/tests/servers/misc layout.
moshi() {
  local dir="${1:-$PWD}"
  if [[ ! -d "$dir" ]]; then
    echo "Directory not found: $dir" >&2
    return 1
  fi

  local abs
  abs="$(builtin cd -- "$dir" && pwd)" || return

  local session
  session="$(basename "$abs" | LC_ALL=C tr -cs '[:alnum:]_-' '-')"
  session="${session#-}"
  session="${session%-}"
  [[ -n "$session" ]] || session="main"

  if ! tmux has-session -t "$session" 2>/dev/null; then
    tmux new-session -d -s "$session" -c "$abs" -n agent || return
    tmux new-window -t "$session":2 -c "$abs" -n review || return
    tmux new-window -t "$session":3 -c "$abs" -n tests || return
    tmux new-window -t "$session":4 -c "$abs" -n servers || return
    tmux new-window -t "$session":5 -c "$abs" -n misc || return
  fi

  tmux attach -t "$session"
}

# Create a worktree for agent work and land this shell in it. The wta script
# execs the agent, so stdout can't carry the path back — it writes the worktree
# path to $WTA_CD_FILE instead, the same trick `wt` uses.
wta() {
  local cd_file
  cd_file="$(mktemp)" || return
  WTA_CD_FILE="$cd_file" command wta "$@"
  local rc=$?
  [[ -s "$cd_file" ]] && builtin cd -- "$(<"$cd_file")"
  command rm -f "$cd_file"
  return $rc
}
