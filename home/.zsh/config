# Load zsh massive renamer
# autoload -U zmv

# Turn off auto correct
unsetopt correct_all

# Don't hang up background jobs
setopt no_hup

# History
export HISTFILE=~/.zhistory
export HISTSIZE="100000"
export SAVEHIST="100000"

setopt append_history
setopt hist_expire_dups_first
setopt extended_history

# Don't show duplicate history entires
setopt hist_find_no_dups

# Remove unnecessary blanks from history
setopt hist_reduce_blanks

# Share history between instances
setopt share_history

# Editor
export EDITOR="zed"
if [[ "$OSTYPE" == linux* ]]; then
  export EDITOR="zeditor"
fi
export GIT_EDITOR="$EDITOR --wait"
export VISUAL=$EDITOR

# Colored man pages
# source: https://github.com/imkira/dotfiles/blob/master/.zsh/colored-man-pages.zsh
export LESS_TERMCAP_mb=$'\E[01;31m'
export LESS_TERMCAP_md=$'\E[01;38;5;74m'
export LESS_TERMCAP_me=$'\E[0m'
export LESS_TERMCAP_se=$'\E[0m'
export LESS_TERMCAP_so=$'\E[38;33;246m'
export LESS_TERMCAP_ue=$'\E[0m'
export LESS_TERMCAP_us=$'\E[04;38;5;146m'

# Set to number of cpus
export MAKEFLAGS="-j4"
export BUNDLE_JOBS="4"

export GOPATH=$HOME/go

# Load ripgrep flags from ~/.config/ripgrep/config
[ -f "$HOME/.config/ripgrep/config" ] && export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"

# Homebrew and its compiler paths are only needed on macOS.
if [[ "$OSTYPE" == darwin* ]]; then
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  else
    eval "$(/usr/local/bin/brew shellenv)"
  fi

  export LDFLAGS="-L$HOMEBREW_PREFIX/opt/openssl@3/lib"
  export CPPFLAGS="-I$HOMEBREW_PREFIX/opt/openssl@3/include"
  export PKG_CONFIG_PATH="$HOMEBREW_PREFIX/opt/openssl@3/lib/pkgconfig"

  PATH="$HOMEBREW_PREFIX/opt/gnu-sed/libexec/gnubin:$HOMEBREW_PREFIX/opt/coreutils/libexec/gnubin:$PATH"
  PATH="$HOMEBREW_PREFIX/opt/openssl/bin:$PATH"
fi
PATH="$GOPATH/bin:$PATH"
PATH="$HOME/.local/bin:$PATH"
PATH="$HOME/.cargo/bin:$PATH"
PATH="$HOME/.bin:$PATH"
export PATH="$HOME/bin:$PATH"

# Add relative bins with highest precedent
PATH="node_modules/.bin:$PATH"
PATH=".bundle/bin:$PATH"
export PATH="bin:$PATH"

# Setup zoxide to replace cd
eval "$(zoxide init zsh)"

# Load plugins from the native package manager.
if [[ "$OSTYPE" == darwin* ]]; then
  source "$HOMEBREW_PREFIX/opt/zsh-fast-syntax-highlighting/share/zsh-fast-syntax-highlighting/fast-syntax-highlighting.plugin.zsh"
  source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
else
  source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
  source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
fi

# Keep Omarchy's environment and mise; macOS continues to use asdf.
if [[ "$OSTYPE" == linux* ]]; then
  [[ -r /usr/share/omarchy/default/bash/env-bootstrap ]] && source /usr/share/omarchy/default/bash/env-bootstrap
  eval "$(mise activate zsh)"
else
  export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"
fi

# Source rust/cargo env
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Load env variables from .envrc - to enable: `direnv allow .`
eval "$(direnv hook zsh)"

eval "$(starship init zsh)"
