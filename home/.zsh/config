autoload -Uz zmv

# Let background jobs survive closing the shell.
setopt no_hup

HISTFILE=~/.zhistory
HISTSIZE=100000
SAVEHIST=100000
setopt hist_expire_dups_first extended_history hist_find_no_dups hist_reduce_blanks share_history

export EDITOR=zed
[[ "$OSTYPE" == linux* ]] && export EDITOR=zeditor
export GIT_EDITOR="$EDITOR --wait"
export VISUAL=$EDITOR

[[ -f "$HOME/.config/ripgrep/config" ]] && export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/config"

# Keep one copy of each directory, including across nested shells.
typeset -U path PATH
# Drop relative entries inherited from older versions of these dotfiles.
path=( ${(M)path:#/*} )

if [[ "$OSTYPE" == darwin* ]]; then
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
  if [[ -n "$HOMEBREW_PREFIX" ]]; then
    for dotfiles_bin in "$HOMEBREW_PREFIX/opt/gnu-sed/libexec/gnubin" "$HOMEBREW_PREFIX/opt/coreutils/libexec/gnubin"; do
      [[ -d "$dotfiles_bin" ]] && path=( "$dotfiles_bin" $path )
    done
  fi
elif [[ "$OSTYPE" == linux* ]]; then
  [[ -r /usr/share/omarchy/default/bash/env-bootstrap ]] && source /usr/share/omarchy/default/bash/env-bootstrap
fi

# Optional tools contribute paths only when installed on this machine.
for dotfiles_bin in "${GOPATH:-$HOME/go}/bin" "$HOME/.local/bin" "$HOME/.cargo/bin" "$HOME/.bin" "$HOME/bin" \
  "${BUN_INSTALL:-$HOME/.bun}/bin" "${PROTO_HOME:-$HOME/.proto}/bin" "${PROTO_HOME:-$HOME/.proto}/shims" "$HOME/.kimi-code/bin"; do
  [[ -d "$dotfiles_bin" ]] && path=( "$dotfiles_bin" $path )
done
unset dotfiles_bin
[[ -r "$HOME/.vite-plus/env" ]] && source "$HOME/.vite-plus/env"

# Keep Omarchy's mise; macOS uses asdf.
if [[ "$OSTYPE" == linux* ]]; then
  (( $+commands[mise] )) && eval "$(mise activate zsh)"
elif [[ -d "${ASDF_DATA_DIR:-$HOME/.asdf}/shims" ]]; then
  path=( "${ASDF_DATA_DIR:-$HOME/.asdf}/shims" $path )
fi

if (( $+commands[zoxide] )); then eval "$(zoxide init zsh)"; fi
if (( $+commands[direnv] )); then eval "$(direnv hook zsh)"; fi
if (( $+commands[starship] )); then eval "$(starship init zsh)"; fi

# Runtime activation can restore PATH saved by an older parent shell.
path=( ${(M)path:#/*} )
