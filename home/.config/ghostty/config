cursor-style-blink = true

# Updates
auto-update-channel = tip

# Shell integrations
shell-integration = zsh
quit-after-last-window-closed = true
shell-integration-features = no-cursor

font-family = Input Mono
font-thicken = true
font-feature = -calt
font-variation = wght=400
font-size = 18

# macos options
macos-non-native-fullscreen = padded-notch
macos-titlebar-style = tabs
macos-option-as-alt = true
macos-titlebar-proxy-icon = hidden

theme = light:dawnfox,dark:ayu
theme = light:ayu,dark:ayu
split-divider-color = 203040

# Scrollback limit (in bytes) - 100MB
scrollback-limit = 100000000

# Window settings
window-width = 90
window-height = 30
window-colorspace = display-p3
window-padding-color = background
window-padding-balance = true
window-padding-x = 0
window-padding-y = 0

keybind = shift+enter=text:\n
keybind = cmd+shift+r=reset

# Clipboard settings
clipboard-read = allow
clipboard-write = allow

# Always show ghostty as the title
title = ghostty
