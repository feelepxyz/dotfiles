user-agent = "Mozilla/5.0 (Windows NT 6.1; rv:52.0) Gecko/20100101 Firefox/52.0"
referer = ";auto"
connect-timeout = 10
progress-bar
max-time = 90
# verbose removed: it dumps full request/response headers (incl. Authorization
# bearer tokens) to stdout on every curl call, even with -s/--silent.
show-error
remote-time
ipv4
